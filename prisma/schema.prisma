generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

///////////////////////
// ENUMS
///////////////////////

enum DatabaseType {
  POSTGRESQL
  MYSQL
}

enum StatusType {
  SUCCESS
  ERROR
}

enum Role {
  user
  assistant
}


///////////////////////
// USER
///////////////////////

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  name      String?
  image     String?
  email     String   @unique
  role      String   @default("user")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  databases DatabaseConnection[]
  queries   QueryLog[]
  chats     Chat[]   // ✅ NEW
}

///////////////////////
// DATABASE CONNECTION
///////////////////////

model DatabaseConnection {
  id        String   @id @default(uuid())
  userId    String
  name      String
  dbType    DatabaseType

  connectionString String

  isActive  Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  queries  QueryLog[]
  chats    Chat[]   // ✅ NEW
}

///////////////////////
// CHAT (NEW)
///////////////////////

model Chat {
  id         String   @id @default(uuid())
  userId     String
  databaseId String?   // 👈 which DB this chat is using

  title      String    // 👈 shown in history

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  database DatabaseConnection? @relation(fields: [databaseId], references: [id])

  messages Message[]
}

///////////////////////
// MESSAGE (NEW)
///////////////////////

model Message {
  id        String   @id @default(uuid())
  chatId    String

  role      Role
  content   String

  // SQL-specific fields (optional per message)
  generatedSQL String?
  result       Json?

  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id])
}

///////////////////////
// QUERY LOG (KEEP)
///////////////////////

model QueryLog {
  id        String   @id @default(uuid())
  userId    String
  databaseConnectionId String

  inputQuery   String
  generatedSQL String
  status       StatusType
  errorMessage String?
  executionTime Int

  createdAt    DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  databaseConnection DatabaseConnection @relation(fields: [databaseConnectionId], references: [id])
}